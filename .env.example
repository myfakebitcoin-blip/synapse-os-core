# Public Cloudflare Worker endpoint used by the frontend build
VITE_WORKER_URL=https://synapse-os-core.myfakebitcoin.workers.dev

# Supabase project settings (the anon/publishable key is intended for client use).
# Never put a service_role key or other secret in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
